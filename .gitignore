# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o exemplo, que é a documentação executável das variáveis.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# render cache / outputs
.tmp/


# runtime-generated scene data & published previews (per-instance, not source)
/data/
/public/photo-previews/

# large render assets / outputs (not source)
/Render/

# bun lockfile — project uses npm (see AGENTS.md)
bun.lock

# dev logs
*.log
.next-dev-*.log

# Modelos do tesseract.js — baixados em runtime pelo layout-ocr, 7,4MB de artefato.
*.traineddata

# Build de produção isolado (NEXT_DIST_DIR) — medir perf sem brigar pelo .next do dev
.next-prod/

# catalogo local e seed (cada maquina tem o seu)
data/catalog.sqlite*
data/catalog-seed.json.gz
.next-shipgate/
