# ─────────────────────────────────────────────────────────────────────────────
# mockup-store — variáveis de ambiente
#
# NADA AQUI É OBRIGATÓRIO PARA SUBIR O APP.
# `npm run setup && npm run dev` funciona com este arquivo inteiro em branco:
# o catálogo lê o disco, a home renderiza, a busca busca. Cada variável abaixo
# LIGA alguma coisa, e o comentário diz exatamente o quê.
#
# Confira o que está ligado a qualquer momento com `npm run setup`.
# ─────────────────────────────────────────────────────────────────────────────


# ── Catálogo ─────────────────────────────────────────────────────────────────

# Metade do catálogo que vem do Mongo (PSDs indexados + cenas publicadas).
# Sem isso: o app NÃO quebra — `search-index.ts` engole a falha e o grid mostra
# só o que está no disco. Mas 6 rotas de API respondem 500 (ingest-folder,
# psd-info, references/tags, photo-mockup/publish, agent/v1/render).
# É uma coleção compartilhada do Visant; não há Docker local nem seed.
MONGODB_URI=
MONGODB_DB_NAME=

# Raízes de PSD no disco, separadas por vírgula. Aceita caminho absoluto de
# qualquer plataforma. Sem isso: nenhum PSD entra no catálogo (as cenas de foto
# continuam aparecendo).
# Cuidado: pai e filha na mesma lista fazem todo arquivo virar cópia de si
# mesmo — `psdRoots()` poda, mas evite. Ex.: /mnt/mockups,/mnt/arquivo
PSD_DIRS=

# Pastas de overlay (Luz/Sombra) para a galeria do editor, separadas por
# vírgula. Sem isso: a galeria de overlays fica vazia, o resto funciona.
OVERLAY_DIRS=


# ── Render ───────────────────────────────────────────────────────────────────

# O render-server é um processo TCP separado (`npm run render`, exige bun).
# Sem ele no ar: navegar e buscar funciona, renderizar não.
RENDER_PORT=4200
RENDER_TIMEOUT_MS=120000
MAX_CONCURRENT_RENDERS=2
# Deixe vazio para o padrão. Alternativa: "photoshop" (só Windows, ver abaixo).
RENDER_ENGINE=

# Render via Photoshop COM — Windows + Photoshop 2020+ instalado. Opcional.
PS_RENDER_PORT=4201
PS_JOB_TIMEOUT_MS=300000


# ── Visant Labs ──────────────────────────────────────────────────────────────

# Marca (paleta + logo) para os lotes brand-aware. Sem isso: o app funciona,
# mas `agent-cli`/`brand-mockup-kit` não conseguem buscar marca.
# Alternativa ao API key: logar uma vez pela UI (tokens vão para ~/.visant/).
VISANT_API_URL=https://api.visantlabs.com/api
VISANT_API_KEY=

# Login OAuth do usuário final. Só se for expor o app para terceiros.
VISANT_OAUTH_ISSUER=
VISANT_OAUTH_CLIENT_ID=
VISANT_OAUTH_CLIENT_SECRET=
VISANT_OAUTH_REDIRECT_URI=
VISANT_OAUTH_SCOPES=
VISANT_OAUTH_CLIENT_NAME=


# ── Serviços pagos (cada um liga uma ferramenta do editor) ───────────────────

# Segmentação (SAM), profundidade, reluz, upscale e edição generativa.
# Sem isso: as ferramentas correspondentes ficam indisponíveis; o editor
# manual (quad, máscara, warp) continua inteiro.
REPLICATE_API_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_BBOX_MODEL=
NVIDIA_API_KEY=


# ── Acesso headless ──────────────────────────────────────────────────────────

# Protege as rotas /api/agent/v1/*. Sem isso: as rotas de agente ficam abertas
# em dev e recusam em produção.
MOCKUP_STORE_AGENT_KEY=

# Deixa /api/fs/pick-folder abrir o seletor de pastas do Windows a partir do app.
# Só faz sentido rodando local, e só funciona no Windows, em requisição de
# localhost. Sem isso: o botão "Seletor do Windows" recusa e o navegador de
# pastas embutido (que é portátil) assume. Ligue com 1.
INGEST_NATIVE_PICKER=
